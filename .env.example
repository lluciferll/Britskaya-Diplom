# Локально без Docker: скопируй в .env.local
# Docker Compose читает тот же набор из файла `.env` в корне проекта.
# Значения: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Адрес, по которому ты реально заходишь в приложение (для ссылок в письмах Supabase).
# Docker с портом 3050: http://localhost:3050 — не используй http://0.0.0.0:3000 из лога Next.
NEXT_PUBLIC_SITE_URL=http://localhost:3050

