# Скопируй в .env.production перед деплоем на Amvera:
#   copy .env.production.example .env.production
#
# На Amvera переменные панели НЕ доступны на этапе docker build —
# Next.js читает этот файл при npm run build.
#
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Публичный URL сайта на Amvera (https, без слэша в конце).
# После первого деплоя подставь реальный домен и сделай git push ещё раз.
NEXT_PUBLIC_SITE_URL=https://your-project.amvera.app
